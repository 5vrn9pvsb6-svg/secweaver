# 复制为 .sops.yaml 或由 DATAASSET_ROOT=dataasset src/dataasset/credentials/sops-vault.sh init 自动生成
# creation_rules 按路径匹配 age 公钥；私钥保存在 .age/key.txt（已 gitignore）

creation_rules:
  - path_regex: secrets/.*\.enc\.yaml$
    encrypted_regex: '^(access_key_secret|password|private_key|token|access_token|api_key|api_secret|security_token)$'
    age: REPLACE_WITH_YOUR_AGE_PUBLIC_KEY
