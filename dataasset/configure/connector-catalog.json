{
  "version": "1.0",
  "format_version": "2.0",
  "description": "Single source for built-in connector runtime, dependency, onboarding template, and Studio profile metadata.",
  "connectors": {
    "sls": {
      "source": "built_in",
      "query_key": "sls_query",
      "runtime": "live_fetch",
      "dependency_hint": "Core dependency: aliyun-log-python-sdk.",
      "dependency_hint_zh": "核心依赖：aliyun-log-python-sdk。",
      "packages": [
        "aliyun-log-python-sdk"
      ],
      "execution_order": [
        "aliyun_sls_sdk"
      ],
      "missing_dependency": "Install requirements-data-access.txt or aliyun-log-python-sdk.",
      "onboarding_template": "sls",
      "onboarding_profile": {
        "label": "Aliyun SLS",
        "fields": [
          "project",
          "logstore",
          "endpoint",
          "region",
          "host_id"
        ],
        "required": [
          "project",
          "logstore",
          "endpoint"
        ],
        "defaults": {
          "project": "YOUR_SLS_PROJECT",
          "logstore": "YOUR_LOGSTORE",
          "endpoint": "cn-hangzhou.log.aliyuncs.com",
          "region": "cn-hangzhou"
        },
        "default_asset_type": "waf_alert",
        "template_params": [
          "src_ip",
          "target_ip",
          "time_start",
          "time_end",
          "limit"
        ],
        "template_defaults": {
          "limit": 1000
        },
        "default_query": "(src_ip: {src_ip} OR client_ip: {src_ip}) | select * limit {limit}",
        "hint": "适合阿里云 SLS 日志；填写 project、logstore 和 endpoint 后即可预览。"
      }
    },
    "sls_proxy": {
      "source": "built_in",
      "query_key": "sls_query",
      "runtime": "live_fetch",
      "dependency_hint": "Core dependency: aliyun-log-python-sdk; optional project and logstore select authorized resources. Region and upstream credentials remain server-managed.",
      "dependency_hint_zh": "核心依赖：aliyun-log-python-sdk；可选 project 与 logstore 选择获授权资源；region 和上游凭证由 SaaS 管理。",
      "packages": [
        "aliyun-log-python-sdk"
      ],
      "execution_order": [
        "aliyun_sls_sdk",
        "secweaver_sls_proxy"
      ],
      "missing_dependency": "Install requirements-data-access.txt or aliyun-log-python-sdk.",
      "onboarding_template": "sls_proxy",
      "onboarding_profile": {
        "label": "SecWeaver SLS Proxy",
        "fields": [
          "project",
          "logstore",
          "endpoint",
          "fallback_endpoint",
          "host_id"
        ],
        "required": [
          "logstore",
          "endpoint"
        ],
        "defaults": {
          "project": "",
          "logstore": "YOUR_LOGSTORE",
          "endpoint": "https://sls-proxy.id-net.cn:30443",
          "fallback_endpoint": "https://sls-proxy.id-net.cn:30443"
        },
        "default_asset_type": "waf_alert",
        "template_params": [
          "src_ip",
          "target_ip",
          "time_start",
          "time_end",
          "limit"
        ],
        "template_defaults": {
          "limit": 1000
        },
        "default_query": "(src_ip: {src_ip} OR client_ip: {src_ip}) | select * limit {limit}",
        "hint": "填写获授权的 project 和 logstore；project 留空使用服务端默认 Project。显式 Project 需要支持多 Project 的 Proxy；region 和上游凭据仍由服务端管理。默认 HTTPS 30443，无独立备用入口。"
      }
    },
    "ssh_file": {
      "source": "built_in",
      "query_key": "ssh_command",
      "runtime": "live_fetch",
      "dependency_hint": "Core dependency: paramiko.",
      "dependency_hint_zh": "核心依赖：paramiko。",
      "packages": [
        "paramiko"
      ],
      "execution_order": [
        "paramiko_ssh"
      ],
      "missing_dependency": "Install requirements-data-access.txt or paramiko.",
      "onboarding_template": "ssh_file",
      "onboarding_profile": {
        "label": "SSH log file",
        "fields": [
          "host",
          "host_id",
          "port"
        ],
        "required": [
          "host"
        ],
        "defaults": {
          "host": "YOUR_HOST",
          "port": 22
        },
        "default_asset_type": "ssh_auth",
        "template_params": [
          "grep_pattern",
          "max_lines"
        ],
        "template_defaults": {
          "grep_pattern": "sshd",
          "max_lines": 200
        },
        "default_query": "grep -E '{grep_pattern}' /var/log/auth.log | tail -n {max_lines}",
        "hint": "适合通过 SSH 只读日志文件。"
      }
    },
    "ssh_command": {
      "source": "built_in",
      "query_key": "ssh_command",
      "runtime": "live_fetch",
      "dependency_hint": "Core dependency: paramiko.",
      "dependency_hint_zh": "核心依赖：paramiko。",
      "packages": [
        "paramiko"
      ],
      "execution_order": [
        "paramiko_ssh"
      ],
      "missing_dependency": "Install requirements-data-access.txt or paramiko.",
      "onboarding_template": "ssh_command",
      "onboarding_profile": {
        "label": "SSH command",
        "fields": [
          "host",
          "host_id",
          "port"
        ],
        "required": [
          "host"
        ],
        "defaults": {
          "host": "YOUR_HOST",
          "port": 22
        },
        "default_asset_type": "linux_syslog",
        "template_params": [
          "grep_pattern",
          "max_lines"
        ],
        "template_defaults": {
          "grep_pattern": "error|failed|accepted",
          "max_lines": 200
        },
        "default_query": "journalctl --no-pager | grep -E '{grep_pattern}' | tail -n {max_lines}",
        "hint": "适合受控只读命令采集。"
      }
    },
    "agent_stream": {
      "source": "built_in",
      "query_key": "stream_query",
      "runtime": "local_or_external_executor",
      "dependency_hint": "No vendor SDK; local samples, external executor, or planned metadata.",
      "dependency_hint_zh": "不绑定厂商 SDK；支持本地样本、外部执行器或 planned metadata。",
      "packages": [],
      "execution_order": [
        "local_sample",
        "external_executor",
        "planned_metadata"
      ],
      "missing_dependency": "Configure sample_file/sample_dir or connector.config.endpoint for live data.",
      "onboarding_template": "agent_stream",
      "onboarding_profile": {
        "label": "Agent stream",
        "fields": [
          "endpoint",
          "base_url",
          "sample_file",
          "sample_dir"
        ],
        "required": [],
        "defaults": {
          "endpoint": "http://127.0.0.1:8788/fetch",
          "sample_file": "examples/log-format-discovery/waf-jsonl.sample"
        },
        "default_asset_type": "waf_alert",
        "template_params": [
          "src_ip",
          "time_start",
          "time_end",
          "limit"
        ],
        "template_defaults": {
          "limit": 1000
        },
        "default_query": "stream where src_ip = '{src_ip}' limit {limit}",
        "hint": "适合配置型新 connector_type；query key 来自 external-connectors.json。"
      }
    },
    "database_ro": {
      "source": "built_in",
      "query_key": "sql",
      "runtime": "live_fetch",
      "dependency_hint": "MySQL/PostgreSQL drivers are core; Oracle/SQL Server drivers are lazy optional; SQLite uses stdlib.",
      "dependency_hint_zh": "MySQL/PostgreSQL 驱动为核心依赖；Oracle/SQL Server 驱动 lazy import；SQLite 使用标准库。",
      "packages": [
        "pymysql",
        "psycopg[binary]",
        "oracledb (optional)",
        "pyodbc (optional)"
      ],
      "execution_order": [
        "select_only_driver",
        "sqlite_stdlib"
      ],
      "missing_dependency": "Install the engine-specific driver named in the error message.",
      "onboarding_template": "database_ro",
      "onboarding_profile": {
        "label": "Read-only database",
        "fields": [
          "engine",
          "host",
          "port",
          "database",
          "path",
          "driver",
          "connection_string"
        ],
        "required": [
          "engine"
        ],
        "defaults": {
          "engine": "mysql",
          "host": "db.example.com",
          "port": 3306,
          "database": "security_logs"
        },
        "default_asset_type": "db_audit",
        "template_params": [
          "src_ip",
          "time_start",
          "time_end",
          "limit"
        ],
        "template_defaults": {
          "limit": 1000
        },
        "default_query": "select * from security_events where src_ip = :src_ip limit :limit",
        "hint": "支持 MySQL、PostgreSQL、Oracle/PLSQL、SQL Server 和 SQLite；SQLite 填 path。"
      }
    },
    "http_api": {
      "source": "built_in",
      "query_key": "http",
      "runtime": "live_fetch",
      "dependency_hint": "No vendor SDK; uses HTTP/REST.",
      "dependency_hint_zh": "不需要厂商 SDK；使用 HTTP/REST。",
      "packages": [],
      "execution_order": [
        "http_rest"
      ],
      "missing_dependency": "No SDK required.",
      "onboarding_template": "http_api",
      "onboarding_profile": {
        "label": "HTTP API",
        "fields": [
          "base_url"
        ],
        "required": [
          "base_url"
        ],
        "defaults": {
          "base_url": "https://api.example.com"
        },
        "default_asset_type": "waf_alert",
        "template_params": [
          "src_ip",
          "time_start",
          "time_end",
          "limit"
        ],
        "template_defaults": {
          "limit": 1000
        },
        "default_query": "GET /events?src_ip={src_ip}&limit={limit}",
        "hint": "适合已有 HTTP 查询接口。"
      }
    },
    "es": {
      "source": "built_in",
      "query_key": "es_query",
      "runtime": "live_fetch",
      "dependency_hint": "No Elasticsearch SDK; uses the HTTP-compatible query API.",
      "dependency_hint_zh": "不需要 Elasticsearch SDK；使用 HTTP 兼容查询 API。",
      "packages": [],
      "execution_order": [
        "http_rest"
      ],
      "missing_dependency": "No SDK required.",
      "onboarding_template": "es",
      "onboarding_profile": {
        "label": "Elasticsearch",
        "fields": [
          "url",
          "index"
        ],
        "required": [
          "url",
          "index"
        ],
        "defaults": {
          "url": "https://es.example.com:9200",
          "index": "security-*"
        },
        "default_asset_type": "web_access_log",
        "template_params": [
          "src_ip",
          "time_start",
          "time_end",
          "limit"
        ],
        "template_defaults": {
          "limit": 1000
        },
        "default_query": "{\"query\":{\"bool\":{\"filter\":[{\"term\":{\"src_ip\":\"{src_ip}\"}}]}},\"size\":{limit}}",
        "hint": "适合 Elasticsearch/OpenSearch 兼容查询。"
      }
    },
    "local_file": {
      "source": "built_in",
      "query_key": "local_file_command",
      "runtime": "live_fetch",
      "dependency_hint": "No SDK; uses Python stdlib local file access.",
      "dependency_hint_zh": "不需要 SDK；使用 Python 标准库读取本地文件。",
      "packages": [],
      "execution_order": [
        "local_file"
      ],
      "missing_dependency": "No SDK required.",
      "onboarding_template": "local_file",
      "onboarding_profile": {
        "label": "Local file",
        "fields": [
          "base_path",
          "host"
        ],
        "required": [
          "base_path"
        ],
        "defaults": {
          "base_path": "examples/log-format-discovery"
        },
        "default_asset_type": "web_access_log",
        "template_params": [
          "grep_pattern",
          "max_lines"
        ],
        "template_defaults": {
          "grep_pattern": ".*",
          "max_lines": 200
        },
        "default_query": "grep -E '{grep_pattern}' {base_path}/*.sample | tail -n {max_lines}",
        "hint": "适合离线样本、PoC 和本地文件目录。"
      }
    },
    "syslog_ingest": {
      "source": "built_in",
      "query_key": "syslog_query",
      "runtime": "local_or_external_executor",
      "dependency_hint": "No vendor SDK; local samples, external executor, or planned metadata.",
      "dependency_hint_zh": "不绑定厂商 SDK；支持本地样本、外部执行器或 planned metadata。",
      "packages": [],
      "execution_order": [
