        "hint": "适合配置型新 connector_type；query key 来自 external-connectors.json。"
      }
    },
    "object_storage": {
      "source": "built_in",
      "query_key": "object_query",
      "runtime": "local_or_external_executor",
      "dependency_hint": "No vendor SDK; local samples, external executor, or planned metadata.",
      "dependency_hint_zh": "不绑定厂商 SDK；支持本地样本、外部执行器或 planned metadata。",
      "packages": [],
      "execution_order": [
        "local_sample",
        "external_executor",
        "planned_metadata"
      ],
      "missing_dependency": "Configure sample_file/sample_dir, local bucket/prefix, or connector.config.endpoint.",
      "onboarding_template": "object_storage",
      "onboarding_profile": {
        "label": "Object storage",
        "fields": [
          "endpoint",
          "base_url",
          "sample_file",
          "sample_dir"
        ],
        "required": [],
        "defaults": {
          "endpoint": "http://127.0.0.1:8788/fetch",
          "sample_file": "examples/log-format-discovery/waf-jsonl.sample"
        },
        "default_asset_type": "web_access_log",
        "template_params": [
          "src_ip",
          "time_start",
          "time_end",
          "limit"
        ],
        "template_defaults": {
          "limit": 1000
        },
        "default_query": "{\"prefix\":\"logs/\",\"filter\":{\"src_ip\":\"{src_ip}\"},\"limit\":{limit}}",
        "hint": "适合配置型新 connector_type；query key 来自 external-connectors.json。"
      }
    },
    "aws_cloudwatch": {
      "source": "built_in",
      "query_key": "cloudwatch_query",
      "runtime": "live_or_external_executor",
      "dependency_hint": "Optional lazy SDK: boto3. Core falls back to SigV4 REST or an external executor.",
      "dependency_hint_zh": "可选 lazy SDK：boto3；核心可走 SigV4 REST fallback 或外部执行器。",
      "packages": [
        "boto3 (optional)"
      ],
      "execution_order": [
        "local_sample",
        "external_executor",
        "boto3",
        "sigv4_rest",
        "planned_metadata"
      ],
      "missing_dependency": "boto3 is optional; without it SecWeaver tries REST fallback when credentials are present.",
      "onboarding_template": "aws_cloudwatch",
      "onboarding_profile": {
        "label": "AWS CloudWatch Logs",
        "fields": [
          "executor_endpoint",
          "region",
          "log_group",
          "log_stream_prefix",
          "sample_file",
          "sample_dir"
        ],
        "required": [
          "region",
          "log_group"
        ],
        "defaults": {
          "region": "ap-southeast-1",
          "log_group": "/aws/cloudtrail/organization",
          "log_stream_prefix": "2026/"
        },
        "default_asset_type": "waf_alert",
        "template_params": [
          "src_ip",
          "time_start",
          "time_end",
          "limit"
        ],
        "template_defaults": {
          "limit": 1000
        },
        "default_query": "fields @timestamp, @message | filter sourceIPAddress = '{src_ip}' | sort @timestamp desc | limit {limit}",
        "hint": "核心包不内置 boto3；可接 examples/executors/aws_cloudwatch_executor.py。"
      }
    },
    "aws_s3_logs": {
      "source": "built_in",
      "query_key": "object_query",
      "runtime": "live_or_external_executor",
      "dependency_hint": "Optional lazy SDK: boto3. Local samples and external executors are supported.",
      "dependency_hint_zh": "可选 lazy SDK：boto3；支持本地样本和外部执行器。",
      "packages": [
        "boto3 (optional)"
      ],
      "execution_order": [
        "local_sample",
        "external_executor",
        "boto3",
        "planned_metadata"
      ],
      "missing_dependency": "boto3 is optional; configure sample_file/sample_dir or install boto3 for live S3 fetch.",
      "onboarding_template": "aws_s3_logs",
      "onboarding_profile": {
        "label": "AWS S3 logs",
        "fields": [
          "bucket",
          "prefix",
          "region",
          "executor_endpoint",
          "sample_file",
          "sample_dir"
        ],
        "required": [
          "bucket"
        ],
        "defaults": {
          "bucket": "YOUR_BUCKET",
          "prefix": "AWSLogs/",
          "region": "ap-southeast-1"
        },
        "default_asset_type": "web_access_log",
        "template_params": [
          "src_ip",
          "limit"
        ],
        "template_defaults": {
          "limit": 1000
        },
        "default_query": "{\"prefix\":\"logs/\",\"filter\":{\"src_ip\":\"{src_ip}\"},\"limit\":{limit}}",
        "hint": "填写 S3 bucket；prefix 可限制扫描范围，region 未填写时使用凭证或 SDK 默认区域。"
      }
    },
    "azure_monitor": {
      "source": "built_in",
      "query_key": "kql",
      "runtime": "live_or_external_executor",
      "dependency_hint": "No Azure SDK by default; uses external executor or Log Analytics REST.",
      "dependency_hint_zh": "默认不安装 Azure SDK；可走外部执行器或 Log Analytics REST。",
      "packages": [],
      "execution_order": [
        "local_sample",
        "external_executor",
        "oauth_rest",
        "planned_metadata"
      ],
      "missing_dependency": "Provide token/client credentials or wrap Azure SDK in an external executor/plugin.",
      "onboarding_template": "azure_monitor",
      "onboarding_profile": {
        "label": "Azure Monitor",
        "fields": [
          "workspace_id",
          "tenant_id",
          "endpoint",
          "executor_endpoint",
          "sample_file",
          "sample_dir"
        ],
        "required": [
          "workspace_id"
        ],
        "defaults": {
          "workspace_id": "YOUR_WORKSPACE_ID"
        },
        "default_asset_type": "waf_alert",
        "template_params": [
          "src_ip",
          "time_start",
          "time_end",
          "limit"
        ],
        "template_defaults": {
          "limit": 1000
        },
        "default_query": "AzureDiagnostics | where SourceIP == '{src_ip}' | take {limit}",
        "hint": "填写 Log Analytics workspace_id；tenant_id 仅在凭证或租户流程需要时填写。"
      }
    },
