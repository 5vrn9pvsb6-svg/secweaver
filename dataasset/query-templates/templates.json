    "firewall_by_src_ip_time": {
      "asset_types": ["firewall_log"],
      "connector_types": ["sls", "es"],
      "params": ["src_ip", "time_start", "time_end", "limit"],
      "defaults": { "limit": 5000 },
      "description": "防火墙：按源 IP + 时间窗；时间边界由 API from/to 控制",
      "sls_query": "src_ip: {src_ip} OR sip: {src_ip} | select * limit {limit}",
      "es_query": {
        "query": {
          "bool": {
            "must": [
              {
                "bool": {
                  "should": [
                    { "term": { "src_ip": "{src_ip}" } },
                    { "term": { "sip": "{src_ip}" } }
                  ],
                  "minimum_should_match": 1
                }
              },
              {
                "range": {
                  "@timestamp": {
                    "gte": "{time_start}",
                    "lte": "{time_end}"
                  }
                }
              }
            ]
          }
        },
        "size": "{limit}",
        "sort": [{ "@timestamp": "desc" }]
      }
    },
    "firewall_by_src_dst_time": {
