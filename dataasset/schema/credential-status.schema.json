{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secweaver.local/schemas/credential-status.json",
  "title": "SecWeaver Credential Lifecycle Status",
  "type": "object",
  "propertyNames": {
    "allOf": [
      { "pattern": "^vault://[^/]+/.+$" },
      { "not": { "pattern": "/\\.\\.?(/|$)" } }
    ]
  },
  "additionalProperties": {
    "enum": ["active", "disabled"]
  }
}
