{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secweaver.local/schemas/query-templates.json",
  "title": "SecWeaver Query Template Catalog",
  "type": "object",
  "required": ["version", "description", "default_templates", "templates"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "default_templates": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
        "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    },
    "templates": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/template" }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "template": {
      "type": "object",
      "required": ["asset_types", "connector_types", "params"],
      "properties": {
        "asset_types": { "$ref": "#/$defs/stringList" },
        "connector_types": { "$ref": "#/$defs/stringList" },
        "params": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "uniqueItems": true
        },
        "defaults": { "type": "object" },
        "description": { "type": "string" },
        "sls_query": { "type": "string", "minLength": 1 },
        "sql": { "type": "string", "minLength": 1 },
        "ssh_command": { "type": "string", "minLength": 1 },
        "local_file_command": { "type": "string", "minLength": 1 },
        "http": { "type": "object" },
        "es_query": { "type": "object" }
      },
      "anyOf": [
        { "required": ["sls_query"] },
        { "required": ["sql"] },
        { "required": ["ssh_command"] },
        { "required": ["local_file_command"] },
        { "required": ["http"] },
        { "required": ["es_query"] }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
