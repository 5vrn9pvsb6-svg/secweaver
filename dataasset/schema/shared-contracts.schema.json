{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secweaver.local/schema/shared-contracts.schema.json",
  "title": "DataAsset multi-root shared contract policy",
  "type": "object",
  "required": ["format_version", "contract_scope", "shared", "override", "root_owned"],
  "properties": {
    "format_version": {"const": "1.0"},
    "description": {"type": "string", "minLength": 1},
    "contract_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "shared": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "override": {
      "type": "array",
      "items": {"$ref": "#/$defs/reasonedPattern"}
    },
    "root_owned": {
      "type": "array",
      "items": {"$ref": "#/$defs/reasonedPattern"}
    }
  },
  "$defs": {
    "reasonedPattern": {
      "type": "object",
      "required": ["pattern", "reason"],
      "properties": {
        "pattern": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
