{
  "template_id": "YOUR_TEMPLATE_ID",
  "asset_types": ["waf_alert"],
  "connector_types": ["es"],
  "params": ["src_ip", "time_start", "time_end", "limit"],
  "defaults": { "limit": 2000 },
  "es_query": {
    "query": {
      "bool": {
        "must": [
          { "term": { "src_ip": "{src_ip}" } },
          { "range": { "@timestamp": { "gte": "{time_start}", "lte": "{time_end}" } } }
        ]
      }
    },
    "size": "{limit}",
    "sort": [{ "@timestamp": "desc" }]
  }
}
