{
  "template_id": "YOUR_TEMPLATE_ID",
  "asset_types": [
    "waf_alert"
  ],
  "connector_types": [
    "gcp_logging"
  ],
  "params": [
    "src_ip",
    "time_start",
    "time_end",
    "limit"
  ],
  "defaults": {
    "limit": 1000
  },
  "gcp_logging_filter": "timestamp >= '{time_start}' AND timestamp <= '{time_end}' AND jsonPayload.src_ip = '{src_ip}'"
}
