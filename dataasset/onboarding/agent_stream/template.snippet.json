{
  "template_id": "YOUR_TEMPLATE_ID",
  "asset_types": [
    "waf_alert"
  ],
  "connector_types": [
    "agent_stream"
  ],
  "params": [
    "src_ip",
    "time_start",
    "time_end",
    "limit"
  ],
  "defaults": {
    "limit": 1000
  },
  "stream_query": "src_ip={src_ip} time_start={time_start} time_end={time_end} limit={limit}",
  "note": "agent_stream 通过 endpoint/base_url 转发给外部 agent stream executor；未配置 endpoint 时返回 planned meta。"
}
