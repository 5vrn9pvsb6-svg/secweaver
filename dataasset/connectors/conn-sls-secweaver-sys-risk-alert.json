{
  "connector_id": "conn-sls-secweaver-sys-risk-alert",
  "name": "SecWeaver SLS - Linux 系统风险报警日志 (/var/log/syslog-risk-json.log)",
  "connector_type": "sls",
  "status": "draft",
  "credentials_ref": "vault://sls/sls-readonly",
  "description": "SecWeaver 系统风险日志示例；请将 project/logstore 替换为实际的阿里云 SLS 只读数据源。源文件 /var/log/syslog-risk-json.log。",
  "config": {
    "endpoint": "cn-hangzhou.log.aliyuncs.com",
    "region": "cn-hangzhou",
    "project": "YOUR_SLS_PROJECT",
    "logstore": "YOUR_SYSLOG_RISK_LOGSTORE",
    "source_log_path": "/var/log/messages"
  },
  "constraints": {
    "max_rows": 5000,
    "max_time_span_hours": 72,
    "query_language": "sls_sql"
  }
}
