{
  "connector_id": "conn-db-sec-audit",
  "name": "安全审计库 MySQL 只读",
  "connector_type": "database_ro",
  "status": "active",
  "credentials_ref": "vault://db/ai-readonly",
  "config": {
    "engine": "mysql",
    "host": "db-audit.internal.example.com",
    "port": 3306,
    "database": "sec_audit",
    "table_mapping": {
      "waf_alert": "waf_alerts",
      "ssh_auth": "login_events",
      "asset_inventory": "cmdb_hosts"
    },
    "column_denylist": ["password", "secret", "token", "private_key", "api_key"]
  },
  "constraints": {
    "max_rows": 2000,
    "query_timeout_sec": 30,
    "require_time_filter": true,
    "require_where_clause": true
  }
}
