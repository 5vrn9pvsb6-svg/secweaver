{
  "connector_id": "conn-sls-secweaver-host-persistence",
  "name": "SecWeaver SLS - 主机持久化变更 (/var/log/host-persistence.log)",
  "connector_type": "sls",
  "status": "draft",
  "credentials_ref": "vault://sls/sls-readonly",
  "description": "secweaver-agent host-persistence 模块输出日志；请按生产环境修改 project/logstore。",
  "config": {
    "endpoint": "cn-hangzhou.log.aliyuncs.com",
    "region": "cn-hangzhou",
    "project": "YOUR_SLS_PROJECT",
    "logstore": "YOUR_HOST_PERSISTENCE_LOGSTORE",
    "source_log_path": "/var/log/host-persistence.log"
  },
  "constraints": {
    "max_rows": 5000,
    "max_time_span_hours": 72,
    "query_language": "sls_sql"
  }
}
