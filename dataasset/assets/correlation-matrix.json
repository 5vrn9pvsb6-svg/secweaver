{
  "version": "1.1",
  "description": "SecWeaver 跨源证据关联矩阵。Join 键建议使用 canonical 字段，也允许直接写源字段；字段归一由 evidence-minimum-fields.json 与 asset.field_aliases 负责，查询参数映射由 fetch_plan.param_map 与 query-templates 负责。",
  "design_intent": {
    "goal": "把安全调查中“哪些证据可以关联、在多大时间窗内关联”固化为一份机器可读的 Join 合同，供告警确认、溯源分析、风险识别等 Skill 复用。",
    "principles": [
      "关联规则集中维护：跨源和主机内部 Join 只在 correlation-matrix.json 定义，Skill 不自行臆造关联。",
      "字段归一与关联解耦：字段别名由 evidence-minimum-fields.json 与 asset.field_aliases 负责，matrix 只描述 Join 语义和少量 Join 局部 variants。",
      "查询编排与 Join 语义解耦：fetch_plan.param_map / query-templates 负责取数参数和索引字段，join_keys 只表达证据之间的语义关联。",
      "时间窗显式化：Join 规则引用 time_windows，避免把相隔很久的无关事件拼成攻击链；调查场景编排由 scenarios/anchor-patterns.json 负责。"
    ],
    "why_internal_joins": "internal_joins 描述同一主机行为域内的 D2 事件链，例如 host_exec、host_connect、host_file_op 之间的连续行为，用于确认打穿、识别高危主机行为和补齐 execution/persistence/C2 阶段。",
    "why_cross_source_joins": "cross_source_joins 描述不同数据源之间的证据桥接，例如 WAF→WEB→host_exec→SSH/防火墙，用于从外部告警追到受害主机、横向路径和影响范围。",
    "why_time_windows": "不同关联关系的合理延迟不同：WEB 告警上下文、攻击成功、主机行为链、横向移动需要不同窗口；显式时间窗可以降低误关联并保留可审计依据。"
  },
  "field_policy": {
    "join_key_naming": "canonical_or_raw",
    "read_preference": "declared_first_then_alias",
    "description": "join_keys.left/right 建议写 canonical 名，也可写源字段名；读事件时依次尝试声明字段 → join_keys.*_variants → alias 正反向候选字段。",
    "layers": [
      "L1 join 规则：left/right 可写 canonical 字段或源字段；推荐 canonical，源字段用于局部例外",
      "L2 全局归一：evidence-minimum-fields.json field_aliases",
      "L3 资产归一：asset.field_aliases",
      "L4 单条 Join 例外：join_keys.*_variants（可选）",
      "L5 查询参数：Join 级 fetch_plan.param_map → query-templates"
    ]
  },
  "confidence_policy": {
    "priority_scale": "1-100，数值越高表示调查时越应优先展示、解释和尝试；90+ 为强证据主链，70-89 为常规调查链，60-69 为辅助线索。",
    "confidence_scale": "0-1，base 是 Join 命中 required keys 后的基础可信度，max 是 optional/secondary keys 加分后的上限。",
    "default_runtime_adjustment": "运行时可按 optional/secondary key 命中情况在 base 与 max 之间小幅上调；无 required key 命中不得生成 join_edges。",
    "operator_reading": "priority 解释“先看哪条链”，confidence 解释“这条命中为什么可信”。二者只用于排序、审计和解释，不允许替代原始证据。",
    "rules": [
      "exact 主键 + 短时间窗的 D2/WEB→host_exec 链路优先级最高。",
      "跨源长时间窗或仅单字段命中的 Join 置信度低于同主机、多键或 5-tuple 互证。",
      "经 CMDB、DNS 或 inventory 富化的 Join 需在 reason 中说明依赖来源。",
      "path Join 的置信度不得高于其关键子 Join 的生产可解释性。"
    ]
  },
  "investigation_param_aliases": {
    "description": "运营可改：调查 params 别名填充。seed_hosts/hosts 首元素自动写入 target_ip，供 victim→WAF/网关反查。",
    "target_ip": [
      "target_ip",
      "seed_hosts",
      "hosts"
    ],
    "attacker_ip": [
      "attacker_ip",
      "src_ip"
    ]
  },
  "trace_stage_map": {
    "victim_host_to_waf_by_target_ip": "initial_access",
    "victim_host_to_web_access_by_target_ip": "initial_access",
    "waf_to_web_access_by_ip": "initial_access",
    "web_access_to_host_exec": "execution",
    "waf_to_host_exec_via_web_access": "execution",
    "waf_to_host_exec_direct": "execution",
    "d2_exec_connect_same_listener": "execution",
    "d2_exec_file_same_host": "execution",
    "d2_connect_file_same_host": "execution",
    "ssh_auth_to_host_exec_same_host": "execution",
    "attacker_ip_to_ssh_auth": "lateral_movement",
    "host_ip_to_ssh_auth_lateral": "lateral_movement",
    "firewall_web_to_internal": "lateral_movement",
    "host_connect_to_dns": "network_activity",
    "nta_session_correlation": "network_activity",
    "lateral_from_exec": "lateral_movement",
    "lateral_from_syslog": "lateral_movement",
    "lateral_from_target_exec": "lateral_movement"
  },
  "time_windows": {
    "alert_context": {
      "before_minutes": 10,
      "after_minutes": 10,
      "use": "WAF 告警前后 WEB 访问"
    },
    "attack_success": {
      "before_minutes": 5,
      "after_minutes": 30,
      "use": "告警确认第二层 host_exec/connect"
    },
    "alert_confirmation_fetch": {
      "before_minutes": 10,
      "after_minutes": 30,
      "use": "告警确认默认取数窗：覆盖 WAF/WEB 上下文与二层主机行为"
    },
    "host_behavior_chain": {
      "before_minutes": 5,
      "after_minutes": 5,
      "use": "同 host D2 exec/connect/file 攻击链"
    },
    "lateral_movement": {
      "before_minutes": 30,
      "after_minutes": 120,
      "use": "SSH/防火墙横向扩散；heuristic（syslog_lateral、target_exec_lateral、lateral_from_exec）互证时间窗"
    },
    "trace_default": {
      "before_hours": 24,
      "after_hours": 6,
      "use": "溯源默认调查窗（相对 alert_time）；由 scenarios/anchor-patterns.json 的 investigation_window 引用，填充 params.time_start/time_end"
    }
  },
