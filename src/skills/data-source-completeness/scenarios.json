        {
          "id": "S1-P2-file",
          "priority": "P2",
          "asset_types": ["host_file_op"],
          "match": "all",
          "required_fields": {
            "host_file_op": ["host", "path", "action", "timestamp"]
          },
          "coverage": "web_hosts",
          "label": "WEB 服务器文件操作"
        },
        {
          "id": "S1-P2-inventory",
          "priority": "P2",
          "asset_types": ["asset_inventory"],
          "match": "all",
          "required_fields": {
            "asset_inventory": ["hostname", "ip"]
          },
          "coverage": "full",
          "label": "资产清单"
        }
      ]
