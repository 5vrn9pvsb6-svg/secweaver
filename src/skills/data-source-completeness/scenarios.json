{
  "version": "1.0",
  "scenarios": {
    "S1": {
      "name": "外网攻击 IP 溯源",
      "keywords": ["外网", "攻击IP", "黑客IP", "溯源", "打穿", "攻破点", "第一个攻破"],
      "requirements": [
        {
          "id": "S1-P0-web",
          "priority": "P0",
          "asset_types": ["waf_alert", "web_access_log"],
          "match": "any",
          "required_fields": {
            "waf_alert": ["src_ip", "timestamp", "url"],
            "web_access_log": ["src_ip", "timestamp", "url"]
          },
          "coverage": "web_zone",
          "label": "WEB/WAF 日志"
        },
        {
          "id": "S1-P0-exec",
          "priority": "P0",
          "asset_types": ["host_exec"],
          "match": "all",
          "required_fields": {
            "host_exec": ["host", "command", "timestamp"]
          },
          "coverage": "web_hosts",
          "label": "WEB 服务器进程命令执行"
        },
        {
          "id": "S1-P0-ssh",
          "priority": "P0",
          "asset_types": ["syslog_risk_alert", "ssh_auth"],
          "match": "any",
          "required_fields": {
            "syslog_risk_alert": ["host_ip", "src_ip", "user", "event_type", "timestamp"],
            "ssh_auth": ["host", "src_ip", "user", "result", "timestamp"]
          },
          "coverage": "internal_ssh",
          "label": "SSH/syslog 认证日志"
        },
        {
          "id": "S1-P1-connect",
          "priority": "P1",
          "asset_types": ["host_connect"],
          "match": "all",
          "required_fields": {
            "host_connect": ["host", "dst_ip", "dst_port", "timestamp"]
          },
          "coverage": "web_hosts",
          "label": "WEB 服务器主动外连"
        },
        {
          "id": "S1-P1-fw",
          "priority": "P1",
          "asset_types": ["firewall_log", "network_traffic_audit"],
          "match": "any",
          "required_fields": {
            "firewall_log": ["src_ip", "dst_ip", "timestamp"],
            "network_traffic_audit": ["src_ip", "dst_ip", "timestamp"]
          },
          "coverage": "dmz_to_internal",
          "label": "防火墙/全流量内网连接"
