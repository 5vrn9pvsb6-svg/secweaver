    },
    {
      "type": "feishu",
      "enabled": false,
      "name": "soc-feishu",
      "webhook_url": "https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_HOOK_ID",
      "secret": ""
    },
    {
      "type": "wecom",
      "enabled": false,
      "name": "soc-wecom",
      "webhook_url": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY"
    }
  ]
