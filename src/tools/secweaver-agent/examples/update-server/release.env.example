# Source from src/tools/secweaver-agent after assigning and committing VERSION.
# VERSION is canonical; do not override it with an environment-only build label.
export UPDATE_SIGNING_PRIVATE_KEY_FILE=/secure/path/secweaver-agent-update-signing.key
export UPDATE_BASE_URL="https://updates.example.com/secweaver-agent/releases/$(cat VERSION)"
export UPDATE_ROLLOUT_PERCENTAGE=10
export UPDATE_DOWNLOAD_SPREAD_SECONDS=3600
export UPDATE_ARTIFACT_SIGNATURE_FORMAT=ed25519-sha256
# Set fresh, monotonic generation and a future RFC3339 expiry for each signed manifest.
# export UPDATE_MANIFEST_GENERATION=...
# export UPDATE_MANIFEST_EXPIRES_AT=...
