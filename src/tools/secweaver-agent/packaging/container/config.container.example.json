{
  "enterprise_id": "REPLACE_WITH_16_CHAR_ID",
  "status_path": "/var/lib/secweaver-agent/status.json",
  "operations_report": {
    "enabled": true,
    "output": "/var/lib/secweaver-agent/logs/secweaver-agent-health.log",
    "snapshot_interval_seconds": 300,
    "jitter_seconds": 60,
    "include_resource_usage": true,
    "include_shipper_status": true
  },
  "disk_budget": {
    "enabled": true,
    "max_total_mb": 512,
    "min_free_mb": 64,
    "check_interval_seconds": 30
  },
  "metrics": {
    "enabled": true,
    "listen_address": "0.0.0.0:9100",
    "path": "/metrics"
  },
  "license": {
    "enabled": false,
    "protocol": "device_v2",
    "state_path": "/var/lib/secweaver-agent/license-state.json",
    "identity_key_path": "/var/lib/secweaver-agent/device-ed25519.key",
    "check_interval_seconds": 21600,
    "heartbeat_interval_seconds": 180,
    "outage_grace_seconds": 86400,
    "fail_closed": true
  },
  "update": {
    "enabled": false
  },
  "modules": {
    "audit-port-execmon": {
      "enabled": false
    },
    "syslog-risk-json": {
      "enabled": false
    },
    "host-persistence": {
      "enabled": false
    },
    "host-process-snapshot": {
      "enabled": true,
      "restart": "on_failure",
      "restart_delay_seconds": 5,
      "args": [
        "-interval", "10m",
        "-full-snapshot-interval", "24h",
        "-state", "/var/lib/secweaver-agent/host-process-snapshot-state.json",
        "-output", "/var/lib/secweaver-agent/host-process-snapshot.log"
      ]
    },
    "host-state-snapshot": {
      "enabled": true,
      "restart": "on_failure",
      "restart_delay_seconds": 5,
      "args": [
        "-container-workload",
        "-socket-interval", "5m",
        "-identity-interval", "5m",
        "-service-interval", "5m",
        "-kernel-interval", "10m",
        "-full-snapshot-interval", "24h",
        "-max-fd-scan", "100000",
        "-state", "/var/lib/secweaver-agent/host-state-snapshot-state.json",
        "-output", "/var/lib/secweaver-agent/host-state-snapshot.log"
      ]
    }
  }
}
